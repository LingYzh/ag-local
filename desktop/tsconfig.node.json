{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/service/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
